# Sanjivani Main Backend Environment Configuration Template
# Copy to .env for local/production configuration

# Standalone ML Prediction & Triage Microservice URL
# (Required in production/staging; defaults to localhost in development)
ML_API_URL=http://127.0.0.1:8001/predict

# Request timeout in seconds for communication with ML microservice
ML_API_TIMEOUT=5.0

# Deployment environment (development | staging | production)
ENVIRONMENT=development

# Admin Secret Token for Model Governance / Metrics endpoint
ADMIN_API_TOKEN=SANJIVANI_ADMIN_SECRET_2026
